func TestService_CreateRoutine_CountGoal(t *testing.T) {
	var captured domain.Routine
	repo := &mocks.MockRoutineRepository{
		CreateRoutineFunc: func(r domain.Routine) (domain.Routine, error) {
			captured = r
			return r, nil
		},
	}
