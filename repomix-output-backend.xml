func TestService_UpdateRoutine_NoFields_NoRepoCall(t *testing.T) {
	called := false
	repo := &mocks.MockRoutineRepository{
		UpdateRoutineFunc: func(userID, routineID uint, updates map[string]interface{}) error {
			called = true
			return nil
		},
	}
