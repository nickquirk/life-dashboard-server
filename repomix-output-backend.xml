		return
	}
	req.UserID = userID

	resp, err := h.Service.DeleteTasks(ctx, req)
	if err != nil {
		h.respondWithError(w, "Failed to delete tasks", err, http.StatusInternalServerError, "userID", userID)
		return
	}

	h.respondWithJSON(w, http.StatusOK, resp, "userID", userID)
